<!DOCTYPE html>
<html lang="en">
<head>
  <title>lib_getter — Edit book</title>
  <%- include('_head') %>
</head>
<body>
  <%- include('_nav') %>
  <main class="page">

    <div class="page-header">
      <h1 class="page-title">Edit book</h1>
      <a href="/" class="btn btn-ghost">Cancel</a>
    </div>

    <div class="card">
      <% if (error) { %><p class="error-msg"><%= error %></p><% } %>
      <form action="/books/<%= book.id %>/edit" method="POST">

        <div class="field">
          <label>Title</label>
          <input type="text" name="label" value="<%= book.label %>" required>
          <p class="hint">What's shown on the wishlist.</p>
        </div>

        <div class="field">
          <label>Search term</label>
          <input type="text" name="query" value="<%= book.query %>" placeholder="Defaults to the title">
          <p class="hint">Sent to each library's catalog search. Try "title author" if the title alone matches the wrong book.</p>
        </div>

        <div class="field">
          <label>ISBN <span class="label-opt">(optional)</span></label>
          <input type="text" name="isbn" value="<%= book.isbn || '' %>" placeholder="9780735211292">
          <p class="hint">When a library result carries this ISBN it's shown as the best match.</p>
        </div>

        <div class="field">
          <label>Format</label>
          <select name="format">
            <% formats.forEach(f => { %>
              <option value="<%= f %>" <%= book.format === f ? 'selected' : '' %>>
                <%= { ebook: 'Ebook', audiobook: 'Audiobook', both: 'Ebook or audiobook' }[f] %>
              </option>
            <% }) %>
          </select>
        </div>

        <button type="submit" class="btn btn-primary">Save changes</button>
      </form>
    </div>

  </main>
</body>
</html>
