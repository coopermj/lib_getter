<!DOCTYPE html>
<html lang="en">
<head>
  <title>lib_getter — Edit library</title>
  <%- include('_head') %>
</head>
<body>
  <%- include('_nav') %>
  <main class="page">

    <div class="page-header">
      <h1 class="page-title">Edit library</h1>
      <a href="/libraries" class="btn btn-ghost">Cancel</a>
    </div>

    <div class="card">
      <% if (error) { %><p class="error-msg"><%= error %></p><% } %>
      <form action="/libraries/<%= lib.id %>/edit" method="POST">
        <%- include('_library_form', { lib }) %>
        <button type="submit" class="btn btn-primary">Save changes</button>
      </form>
    </div>

  </main>
</body>
</html>
