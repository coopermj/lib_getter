<!DOCTYPE html>
<html lang="en">
<head>
  <title>lib_getter</title>
  <%- include('_head') %>
</head>
<body>
  <%- include('_nav') %>
  <main class="page">

    <div class="page-header">
      <h1 class="page-title">Wishlist</h1>
      <button type="button" class="btn btn-ghost" onclick="scanAll(this)">Scan all</button>
    </div>

    <!-- Add book -->
    <% if (error) { %>
      <p class="error-msg"><%= error %></p>
    <% } %>
    <form action="/books" method="POST" class="add-row">
      <input type="text" name="query"
        placeholder="Title, keywords, Amazon or Goodreads URL"
        required>
      <button type="submit" class="btn btn-primary">Add</button>
    </form>

    <!-- Book list -->
    <% if (books.length === 0) { %>
      <p class="empty-state">No books yet. Add one above.</p>
    <% } %>

    <% books.forEach(book => { %>
      <div class="book-card" id="book-<%= book.id %>">
        <div class="book-card-header">
          <div>
            <p class="book-title"><%= book.label %></p>
            <p class="book-scanned" id="scanned-<%= book.id %>"
               data-scanned-at="<%= book.last_scanned_at || '' %>"
               <%= book.last_scanned_at ? '' : 'hidden' %>></p>
          </div>
          <div class="book-actions">
            <button class="btn btn-scan" data-book-id="<%= book.id %>" onclick="scanBook(this.dataset.bookId, this)">
              Scan
            </button>
            <form action="/books/<%= book.id %>/delete" method="POST" style="margin:0;">
              <button type="submit" class="btn-danger">×</button>
            </form>
          </div>
        </div>
        <div id="results-<%= book.id %>"></div>
      </div>
    <% }) %>

  </main>

  <script>
    // Scan every book in the browser so results render inline, with limited concurrency
    async function scanAll(allBtn) {
      const buttons = Array.from(document.querySelectorAll('.btn-scan'));
      allBtn.disabled = true;
      const queue = buttons.slice();
      const worker = async () => {
        while (queue.length) {
          const btn = queue.shift();
          await scanBook(btn.dataset.bookId, btn);
        }
      };
      try {
        await Promise.all([worker(), worker()]);
      } finally {
        allBtn.disabled = false;
      }
    }

    // Render stored ISO timestamps in the viewer's locale
    function showScannedAt(id, iso) {
      const el = document.getElementById('scanned-' + id);
      if (!el || !iso) return;
      el.textContent = 'Scanned ' + new Date(iso).toLocaleString();
      el.hidden = false;
    }
    document.querySelectorAll('.book-scanned').forEach(el => {
      showScannedAt(el.id.replace('scanned-', ''), el.dataset.scannedAt);
    });

    async function scanBook(id, btn) {
      const card      = document.getElementById('book-' + id);
      const resultsEl = document.getElementById('results-' + id);
      btn.disabled    = true;
      btn.textContent = 'Scanning…';
      resultsEl.innerHTML = '<div class="book-results"><span class="scanning">Scanning libraries…</span></div>';
      try {
        const res = await fetch('/books/' + id + '/scan', {
          method: 'POST',
          headers: { 'X-Requested-With': 'fetch' },
        });
        if (res.status === 401) {
          window.location.href = '/login';
          return;
        }
        if (!res.ok) {
          // 4xx bodies are short server-authored messages worth showing; 5xx is the generic error page
          const msg = res.status < 500 ? (await res.text()).replace(/<[^>]+>/g, '').trim() : '';
          throw new Error(msg || 'HTTP ' + res.status);
        }
        resultsEl.innerHTML = await res.text();
        showScannedAt(id, res.headers.get('X-Scanned-At'));
        // light up the accent bar if any result is available
        if (resultsEl.querySelector('.badge-available')) {
          card.classList.add('has-available');
        } else {
          card.classList.remove('has-available');
        }
      } catch (e) {
        const errEl = document.createElement('span');
        errEl.className   = 'badge-error';
        errEl.textContent = 'Request failed: ' + e.message;
        const wrap = document.createElement('div');
        wrap.className = 'book-results';
        wrap.appendChild(errEl);
        resultsEl.replaceChildren(wrap);
      } finally {
        btn.disabled    = false;
        btn.textContent = 'Scan';
      }
    }
  </script>
</body>
</html>
